# Anthropic API キー（Claude 呼び出しに使用）
# https://console.anthropic.com/ から取得して、このファイルを .env.local にコピーして設定してください
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API キー（/recap --gpt の画像生成にのみ使用。任意）
OPENAI_API_KEY=sk-...
# 画像モデル（省略時 gpt-image-2）
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- /recap --llm（要約JSONを外部LLMに書かせる。OmniRoute で無料モデル可） ---
# 接続先。設定手順は docs/omniroute-setup.md（bash scripts/omniroute-setup.sh で自動設定）
# RECAP_LLM_BASE_URL=http://localhost:20128/v1
# 鍵。OmniRoute は既定でキー不要なのでダミーでよい
# RECAP_LLM_API_KEY=omniroute
# モデル。auto / auto/best-free / auto/cheap / oc/<モデル名>
# RECAP_LLM_MODEL=auto
# 応答待ちの上限（ミリ秒。既定 120000）
# RECAP_LLM_TIMEOUT_MS=120000
#
# RECAP_LLM_* が無いときだけ OPENAI_BASE_URL / OPENAI_API_KEY にフォールバックする。
# ただし OPENAI_* を OmniRoute に向けると --gpt（画像生成）が壊れるので、分けて書くこと。
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# --gpt の画像生成の応答待ち上限（ミリ秒。既定 180000）
# RECAP_IMAGE_TIMEOUT_MS=180000
#
# 値に行内コメントを書かないこと（自前パーサで読むため）。コメントは前の行に書く。
