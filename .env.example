# Anthropic API キー（Claude 呼び出しに使用）
# https://console.anthropic.com/ から取得して、このファイルを .env.local にコピーして設定してください
ANTHROPIC_API_KEY=sk-ant-...

# --- Discord メンバー取得（scripts/discord-members.mjs）---
# Developer Portal → Bot → Reset Token で取得。
# 同じ画面の Privileged Gateway Intents で SERVER MEMBERS INTENT を ON にすること。
DISCORD_BOT_TOKEN=
# 対象サーバーのID。node scripts/discord-members.mjs guilds で確認できます。
DISCORD_GUILD_ID=
