# Anthropic API キー（Claude 呼び出しに使用）
# https://console.anthropic.com/ から取得して、このファイルを .env.local にコピーして設定してください
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API キー（/recap --gpt の画像生成にのみ使用。任意）
OPENAI_API_KEY=sk-...
# 画像モデル（省略時 gpt-image-2）
# OPENAI_IMAGE_MODEL=gpt-image-1

# OpenAI互換ゲートウェイの接続先（省略時 api.openai.com。OmniRoute なら http://localhost:20128/v1）
# OPENAI_BASE_URL=http://localhost:20128/v1
# /recap --llm が使うモデル（OmniRoute なら auto）
# RECAP_LLM_MODEL=auto
